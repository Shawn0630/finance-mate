# Finance Mate server configuration.
# Copy this file to ".env" in the project root and fill in real
# values. The .env file is gitignored — never commit it. Values set
# in the process environment (e.g. via docker-compose env_file)
# take precedence over the file.

# --- AI Fill (POST /api/ai/fill) -----------------------------------
# An OpenAI-compatible chat-completions endpoint powers the
# "Fill with AI" extraction — the same variables and semantics as
# the algorithm visualizer's AI assistant, so one setup covers
# both apps. Example for Google Gemini:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# The default model (used when the user has not picked another).
LLM_MODEL=gpt-4o-mini
# Optional: the models the Fill panel's model picker offers
# (comma-separated). Defaults to just LLM_MODEL.
# LLM_MODELS=gpt-4o-mini,gpt-4o
# Optional: per-call timeout in milliseconds (default 180000), and
# a fallback model that automatically takes over when the primary
# model call fails:
# LLM_TIMEOUT_MS=
# LLM_MODEL_FALLBACK=

# --- First-run seed admin (only used while the users table is
# empty) ------------------------------------------------------------
# SEED_ADMIN_USER=admin
# SEED_ADMIN_PASSWORD=
